# migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=<DBSTRING>
GOOSE_MIGRATION_DIR=./migrations

# --- Primary ---
JIGAO_PRIMARY.ENV=development

# --- Server ---
JIGAO_SERVER.PORT=8080
JIGAO_SERVER.READ_TIMEOUT=30
JIGAO_SERVER.WRITE_TIMEOUT=30
JIGAO_SERVER.IDLE_TIMEOUT=120
JIGAO_SERVER.CORS_ALLOWED_ORIGINS=http://localhost:5173 

# --- Database ---
JIGAO_DATABASE.HOST=<DATABASE_HOST>
JIGAO_DATABASE.PORT=5432
JIGAO_DATABASE.USER=<DB_USER>
JIGAO_DATABASE.PASSWORD=<DB_PASSWORD>
JIGAO_DATABASE.NAME=<DB_NAME>
JIGAO_DATABASE.SSL_MODE=require
JIGAO_DATABASE.MAX_OPEN_CONNS=25
JIGAO_DATABASE.MAX_IDLE_CONNS=10
JIGAO_DATABASE.CONN_MAX_LIFETIME=300
JIGAO_DATABASE.CONN_MAX_IDLE_TIME=30

# --- Auth ---
JIGAO_AUTH.SECRET_KEY=<CLERK_SECRET_KEY>

# --- Observability ---
JIGAO_OBSERVABILITY.SERVICE_NAME=jigao
JIGAO_OBSERVABILITY.ENVIRONMENT=development

# Logging
JIGAO_OBSERVABILITY.LOGGING.LEVEL=debug
JIGAO_OBSERVABILITY.LOGGING.FORMAT=console
JIGAO_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD=100ms

# New Relic (leave license_key empty to disable)
JIGAO_OBSERVABILITY.NEW_RELIC.LICENSE_KEY=empty
JIGAO_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED=true
JIGAO_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED=true
JIGAO_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING=false

# Health Checks
JIGAO_OBSERVABILITY.HEALTH_CHECKS.ENABLED=true
JIGAO_OBSERVABILITY.HEALTH_CHECKS.INTERVAL=30s
JIGAO_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT=5s
JIGAO_OBSERVABILITY.HEALTH_CHECKS.CHECKS=database,redis
